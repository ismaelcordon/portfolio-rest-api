{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug TypeScript",
            "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
            "args": ["${workspaceFolder}/src/server.ts"],
            "cwd": "${workspaceFolder}",
            "sourceMaps": true,
            "env": {
                "NODE_ENV": "development"
            },
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/node_modules/**"
            ]
        }
    ]
}
