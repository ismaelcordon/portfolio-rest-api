{
    "name": "com.ismaelcordon.portfolio.api",
    "version": "1.0.0",
    "description": "",
    "main": "app.ts",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "dev": "nodemon --watch src --exec tsx src/server.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/server.js",
        "test:watch": "vitest",
        "test:coverage": "vitest run -c vitest.unit.config.ts --coverage",
        "test:unit": "vitest run -c vitest.unit.config.ts",
        "test:integration": "vitest run -c vitest.integration.config.ts",
        "test": "npm run test:unit && npm run test:integration"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ismael-cordon/portfolio-rest-api.git"
    },
    "author": "Ismael Cordón Domínguez",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/ismael-cordon/portfolio-rest-api/issues"
    },
    "homepage": "https://github.com/ismael-cordon/portfolio-rest-api#readme",
    "imports": {
        "#config/*": "./dist/config/*",
        "#controllers/*": "./dist/controllers/*",
        "#dtos/*": "./dist/dtos/*",
        "#exceptions/*": "./dist/exceptions/*",
        "#helpers/*": "./dist/helpers/*",
        "#mappers/*": "./dist/mappers/*",
        "#middlewares/*": "./dist/middlewares/*",
        "#models/*": "./dist/models/*",
        "#routes/*": "./dist/routes/*",
        "#services/*": "./dist/services/*",
        "#types/*": "./dist/types/*",
        "#utils/*": "./dist/utils/*",
        "#validators/*": "./dist/validators/*"
    },
    "dependencies": {
        "camelcase-keys": "^10.0.2",
        "chalk": "^5.6.2",
        "cors": "^2.8.6",
        "dotenv": "^17.4.1",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "nodemailer": "^8.0.7",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "sequelize": "^6.37.8",
        "slugify": "^1.6.9",
        "snakecase-keys": "^8.1.0"
    },
    "devDependencies": {
        "@types/chalk": "^0.4.31",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.5.2",
        "@types/nodemailer": "^8.0.0",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.3",
        "nodemon": "^3.1.14",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vitest": "^4.1.5"
    }
}
